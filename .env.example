# ---------------------------------------------------------------------------
# Club Canino Nica — variables de entorno
# Copiar a .env.local y rellenar. NUNCA subir .env.local al repositorio.
# ---------------------------------------------------------------------------

# --- Base de datos (Supabase Postgres) -------------------------------------
# DATABASE_URL usa el pooler (puerto 6543) para la app en runtime.
# DIRECT_URL usa conexion directa (puerto 5432) y solo la usa `prisma migrate`.
#
# OJO con la contrasena. Hay que codificarla en la URL:
#   $ -> %24    # -> %23    @ -> %40    / -> %2F    ? -> %3F    & -> %26
#
# El '$' es el que mas engana: Next.js carga .env con @next/env, que expande
# variables al estilo shell, asi que un '$' literal desaparece y Prisma falla
# con P1000 "Authentication failed" AUNQUE la misma URL funcione en un script
# suelto (dotenv a secas no expande). Codificado como %24 funciona en ambos.
#
# El host `db.<ref>.supabase.co` solo resuelve por IPv6. Si da P1001
# "Can't reach database server", usa el pooler (Connect > Session pooler),
# donde el usuario pasa a ser `postgres.<ref>`.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Auth + Storage ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Clave de servicio: solo servidor. Se usa en el seed y en operaciones admin.
# Si esta clave llega al navegador, cualquiera puede leer toda la base.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Storage ----------------------------------------------------------------
# supabase | cloudinary. Ver src/server/providers/storage/
STORAGE_PROVIDER="supabase"
SUPABASE_STORAGE_BUCKET="club-canino"

# --- Camaras ----------------------------------------------------------------
# demo | hls | webrtc. Con "demo" no se sirve video: la interfaz muestra un
# cartel que dice que es una demostracion. No se simula una transmision real.
CAMERA_PROVIDER="demo"
# Base del proveedor de streaming. Solo se usa cuando CAMERA_PROVIDER no es demo.
CAMERA_STREAM_BASE_URL=""
# Secreto para firmar los accesos temporales. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CAMERA_SIGNING_SECRET=""

# --- Pagos ------------------------------------------------------------------
# demo | stripe. Con "demo" se sirve una pantalla de cobro simulada, marcada
# como demostracion, que no pide ni cobra ninguna tarjeta.
PAYMENT_PROVIDER="demo"

# Clave de prueba de Stripe (empieza con sk_test_). Nunca la de produccion aqui.
STRIPE_SECRET_KEY=""

# Secreto del webhook (whsec_...). Sin el, la ruta /api/webhooks/stripe rechaza
# todo: es lo unico que la protege, porque el proveedor no tiene sesion.
# En local se obtiene con:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# --- Correos de autenticacion -------------------------------------------------
# Confirmar cuenta y recuperar contrasena por correo. Dejalo en "false" hasta
# configurar SMTP propio en Supabase: el correo incluido solo entrega a miembros
# del equipo del proyecto. En "false" el registro crea la cuenta ya confirmada y
# las contrasenas olvidadas las restablece un administrador desde el panel.
AUTH_EMAILS_ENABLED="false"

# --- Seed -------------------------------------------------------------------
# Contrasena de las cuentas demo generadas por `npm run db:seed`. Obligatoria:
# el seed falla sin ella a proposito, para que nadie despliegue con una clave
# escrita en un repositorio publico. Generala con:
#   node -e "console.log(require('crypto').randomBytes(15).toString('base64url'))"
# Evita '$' y '#': el primero lo expande @next/env y el segundo abre comentario.
SEED_DEMO_PASSWORD=""

# Segundo administrador, el tuyo. Opcional: si lo dejas vacio, el seed solo crea
# el administrador generico. Va aqui y no en el codigo para no dejar un correo
# personal en el repositorio.
SEED_OWNER_EMAIL=""
SEED_OWNER_NAME=""
